# Keep fixture text files with LF so parsers and golden tests stay portable.
*.trade text eol=lf
*.txt text eol=lf
*.secret text eol=lf
*.ex text eol=lf
*.exs text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.pdf binary
# Fixtures and goldens are compared byte for byte (sizes, hashes). Never
# rewrite line endings on checkout, even with core.autocrlf=true.
test/fixtures/** -text
